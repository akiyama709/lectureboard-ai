{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lectureboard/board-plan.schema.json",
  "title": "LectureBoard AI Board Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "language",
    "items",
    "importance",
    "confidence",
    "sourceSegmentIds"
  ],
  "properties": {
    "kind": {
      "enum": [
        "definition",
        "bulletList",
        "causalChain",
        "comparison",
        "conceptMap",
        "question",
        "callout",
        "plainText"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "title": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      }
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sourceSegmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    }
  }
}
